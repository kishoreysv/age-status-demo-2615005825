# Public local tooling only. No secrets, API URLs or browser persistence.
VITE_DEV_PORT=5173
# Playwright builds and serves the production bundle; these values must agree.
PLAYWRIGHT_PORT=4173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
# Copy to .env.local, or override via your process environment.
# A different baseURL must remain an HTTP loopback origin with no path/query.
